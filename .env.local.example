# PostgreSQL with pgvector (Neon) - REQUIRED
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# OpenAI API - REQUIRED (for embeddings and chat)
OPENAI_API_KEY=sk-...

# Vercel Blob (for document storage) - OPTIONAL (not yet implemented)
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# CSRF Protection - OPTIONAL (set to 'false' in development to disable)
# ENFORCE_CSRF=true

# Session/Auth - OPTIONAL (for future auth features)
# SESSION_SECRET=your-secret-here-min-32-chars
