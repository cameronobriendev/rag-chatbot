# PostgreSQL with pgvector (Neon) - REQUIRED
# Get free account at https://neon.tech
# Make sure to enable pgvector extension in your database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# OpenAI API - REQUIRED (for embeddings and chat)
# Get API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Upload Service URL - OPTIONAL
# If using external upload service (for large files), set this
# Otherwise defaults to /api/upload (Vercel serverless function)
NEXT_PUBLIC_UPLOAD_URL=https://your-upload-service.com/upload

# Session Secret - OPTIONAL (for CSRF protection)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-secret-here-min-32-characters-long
